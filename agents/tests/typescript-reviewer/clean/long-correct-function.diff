--- /dev/null
+++ b/src/reports/monthly.ts
@@ -0,0 +1,28 @@
+import type { PoolClient } from "pg";
+import { fromCents } from "../money.js";
+
+export type MonthlyRow = { category: string; count: number; total: string };
+
+/** Spend per category for one calendar month, in the caller's company. */
+export async function monthlyReport(db: PoolClient, year: number, month: number): Promise<MonthlyRow[]> {
+  if (!Number.isInteger(year) || year < 2000 || year > 2100) {
+    throw new RangeError(`year out of range: ${year}`);
+  }
+  if (!Number.isInteger(month) || month < 1 || month > 12) {
+    throw new RangeError(`month out of range: ${month}`);
+  }
+  const start = `${year}-${String(month).padStart(2, "0")}-01`;
+  try {
+    const { rows } = await db.query<{ category: string; count: string; total: string }>(
+      `SELECT category, count(*)::text AS count, sum(amount_cents)::text AS total
+       FROM expenses
+       WHERE spent_on >= $1::date AND spent_on < ($1::date + interval '1 month')
+       GROUP BY category ORDER BY category`,
+      [start],
+    );
+    return rows.map((r) => ({ category: r.category, count: Number(r.count), total: fromCents(r.total) }));
+  } catch (err) {
+    logger.error({ err, year, month }, "monthly report failed");
+    throw err;
+  }
+}
