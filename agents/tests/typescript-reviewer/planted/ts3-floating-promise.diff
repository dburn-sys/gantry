+import type { User } from "./auth/users.js";
+import { pool } from "./db.js";
+
+export async function recordAudit(actor: User, event: string, subjectId: string): Promise<void> {
+  await pool.query(
+    "INSERT INTO audit_events (actor_id, event, subject_id) VALUES ($1, $2, $3)",
+    [actor.id, event, subjectId],
+  );
+}
