@@ -0,0 +1,12 @@
+import { describe, it, expect, vi } from "vitest";
+vi.mock("../src/webhooks/signature.js", () => ({ verifySignature: vi.fn(() => true) }));
+import { buildApp } from "../src/app.js";
+
+describe("payout webhook", () => {
+  it("OB-1: rejects a request with a bad signature", async () => {
+    const app = buildApp();
+    const res = await app.inject({ method: "POST", url: "/webhooks/payouts",
+      headers: { "x-signature": "bad" }, payload: { id: "evt_1", status: "paid" } });
+    expect(res.statusCode).toBeLessThan(500);
+  });
+});
