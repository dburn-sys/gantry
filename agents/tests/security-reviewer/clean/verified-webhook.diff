diff --git a/src/webhooks/payouts.ts b/src/webhooks/payouts.ts
new file mode 100644
--- /dev/null
+++ b/src/webhooks/payouts.ts
@@ -0,0 +1,28 @@
+import { createHmac, timingSafeEqual } from "node:crypto";
+import type { FastifyInstance } from "fastify";
+import { withCompany } from "../db.js";
+
+const TOLERANCE_S = 300;
+const UUID = /^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$/i;
+type PayoutEvent = { id: string; companyId: string; payoutId: string; status: "paid" | "failed" };
+
+function parseEvent(raw: string): PayoutEvent | null {
+  try {
+    const e = JSON.parse(raw);
+    const ok = typeof e?.id === "string" && e.id.length <= 100 && UUID.test(e.companyId) &&
+      UUID.test(e.payoutId) && (e.status === "paid" || e.status === "failed");
+    return ok ? { id: e.id, companyId: e.companyId, payoutId: e.payoutId, status: e.status } : null;
+  } catch {
+    return null;
+  }
+}
+
+function validSignature(raw: Buffer, header: string, secret: string): boolean {
+  const [t, sig] = header.split(",").map((p) => p.split("=")[1] ?? "");
+  const expected = createHmac("sha256", secret).update(`${t}.${raw}`).digest("hex");
+  const a = Buffer.from(sig, "hex"), b = Buffer.from(expected, "hex");
+  if (a.length !== b.length || !timingSafeEqual(a, b)) return false;
+  return Math.abs(Date.now() / 1000 - Number(t)) <= TOLERANCE_S;
+}
+
+export function registerPayoutWebhook(app: FastifyInstance, secret: string) {
+  app.post("/webhooks/payouts", { config: { rawBody: true } }, async (req, reply) => {
+    if (!validSignature(req.rawBody as Buffer, String(req.headers["x-signature"] ?? ""), secret)) {
+      return reply.code(401).send();
+    }
+    // companyId and payoutId are ids we sent in the payout request's metadata.
+    // The signature proves the provider returned them unchanged.
+    const event = parseEvent(String(req.rawBody));
+    if (!event) return reply.code(400).send();
+    await withCompany(event.companyId, async (db) => {
+      const seen = await db.query("INSERT INTO webhook_events (id) VALUES ($1) ON CONFLICT DO NOTHING", [event.id]);
+      if (seen.rowCount === 0) return;
+      await db.query("UPDATE payouts SET status = $1 WHERE id = $2 AND status = 'pending'",
+        [event.status === "paid" ? "paid" : "failed", event.payoutId]);
+    });
+    return reply.code(200).send();
+  });
+}
