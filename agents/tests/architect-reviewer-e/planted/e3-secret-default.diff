diff --git a/infra/variables.tf b/infra/variables.tf
new file mode 100644
--- /dev/null
+++ b/infra/variables.tf
@@ -0,0 +1,9 @@
+variable "env" {
+  type = string
+}
+
+variable "tally_signing_key" {
+  type      = string
+  sensitive = true
+  default   = "3f9a1c7e5b2d8f4a6c0e9b1d7f3a5c8e"
+}
diff --git a/infra/api.tf b/infra/api.tf
new file mode 100644
--- /dev/null
+++ b/infra/api.tf
@@ -0,0 +1,20 @@
+resource "azurerm_container_app" "api" {
+  name                         = "tally-${var.env}-api"
+  container_app_environment_id = azurerm_container_app_environment.tally.id
+  resource_group_name          = azurerm_resource_group.tally.name
+  revision_mode                = "Single"
+  tags                         = local.tags
+
+  template {
+    container {
+      name   = "api"
+      image  = var.api_image
+      cpu    = 0.5
+      memory = "1Gi"
+      env {
+        name  = "TALLY_SIGNING_KEY"
+        value = var.tally_signing_key
+      }
+    }
+  }
+}
