@@ -0,0 +1,9 @@
+import { withCompany } from "../db.js";
+
+/** A one-time code emailed to a new user to set their password. */
+export async function createInviteCode(companyId: string, email: string): Promise<string> {
+  const code = Array.from({ length: 8 }, () => Math.floor(Math.random() * 36).toString(36)).join("");
+  await withCompany(companyId, (db) =>
+    db.query("INSERT INTO invites (email, code, expires_at) VALUES ($1, $2, now() + interval '1 day')", [email, code]));
+  return code;
+}
