{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python \"${CLAUDE_PLUGIN_ROOT}/hooks/session_start.py\""
          },
          {
            "type": "command",
            "command": "python -c \"\" || python3 \"${CLAUDE_PLUGIN_ROOT}/hooks/session_start.py\""
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash|PowerShell",
        "hooks": [
          {
            "type": "command",
            "command": "python \"${CLAUDE_PLUGIN_ROOT}/hooks/pre_bash.py\""
          },
          {
            "type": "command",
            "command": "python -c \"\" || python3 \"${CLAUDE_PLUGIN_ROOT}/hooks/pre_bash.py\""
          }
        ]
      },
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "python \"${CLAUDE_PLUGIN_ROOT}/hooks/pre_write.py\""
          },
          {
            "type": "command",
            "command": "python -c \"\" || python3 \"${CLAUDE_PLUGIN_ROOT}/hooks/pre_write.py\""
          }
        ]
      },
      {
        "matcher": "mcp__github__.*",
        "hooks": [
          {
            "type": "command",
            "command": "python \"${CLAUDE_PLUGIN_ROOT}/hooks/pre_mcp.py\""
          },
          {
            "type": "command",
            "command": "python -c \"\" || python3 \"${CLAUDE_PLUGIN_ROOT}/hooks/pre_mcp.py\""
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Bash|PowerShell",
        "hooks": [
          {
            "type": "command",
            "command": "python \"${CLAUDE_PLUGIN_ROOT}/hooks/post_bash.py\""
          },
          {
            "type": "command",
            "command": "python -c \"\" || python3 \"${CLAUDE_PLUGIN_ROOT}/hooks/post_bash.py\""
          }
        ]
      },
      {
        "matcher": "Agent|Task",
        "hooks": [
          {
            "type": "command",
            "command": "python \"${CLAUDE_PLUGIN_ROOT}/hooks/post_agent.py\""
          },
          {
            "type": "command",
            "command": "python -c \"\" || python3 \"${CLAUDE_PLUGIN_ROOT}/hooks/post_agent.py\""
          }
        ]
      }
    ],
    "PostToolUseFailure": [
      {
        "matcher": "Bash|PowerShell",
        "hooks": [
          {
            "type": "command",
            "command": "python \"${CLAUDE_PLUGIN_ROOT}/hooks/post_bash.py\""
          },
          {
            "type": "command",
            "command": "python -c \"\" || python3 \"${CLAUDE_PLUGIN_ROOT}/hooks/post_bash.py\""
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python \"${CLAUDE_PLUGIN_ROOT}/hooks/stop_check.py\""
          },
          {
            "type": "command",
            "command": "python -c \"\" || python3 \"${CLAUDE_PLUGIN_ROOT}/hooks/stop_check.py\""
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python \"${CLAUDE_PLUGIN_ROOT}/hooks/prompt_submit.py\""
          },
          {
            "type": "command",
            "command": "python -c \"\" || python3 \"${CLAUDE_PLUGIN_ROOT}/hooks/prompt_submit.py\""
          },
          {
            "type": "command",
            "command": "python \"${CLAUDE_PLUGIN_ROOT}/hooks/prompt_intent.py\""
          },
          {
            "type": "command",
            "command": "python -c \"\" || python3 \"${CLAUDE_PLUGIN_ROOT}/hooks/prompt_intent.py\""
          }
        ]
      }
    ]
  }
}
