{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          { "type": "command", "command": "python \"${CLAUDE_PLUGIN_ROOT}/hooks/session_start.py\"" },
          { "type": "command", "command": "python -c \"\" || python3 \"${CLAUDE_PLUGIN_ROOT}/hooks/session_start.py\"" }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash|PowerShell",
        "hooks": [
          { "type": "command", "command": "python \"${CLAUDE_PLUGIN_ROOT}/hooks/pre_bash.py\"" },
          { "type": "command", "command": "python -c \"\" || python3 \"${CLAUDE_PLUGIN_ROOT}/hooks/pre_bash.py\"" }
        ]
      }
    ]
  }
}
