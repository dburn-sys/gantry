diff --git a/src/money.ts b/src/money.ts
--- a/src/money.ts
+++ b/src/money.ts
@@ -1,5 +1,6 @@
 export function toCents(amount: string): number | null {
-  const m = /^(\d{1,9})(?:\.(\d{1,2}))?$/.exec(amount);
+  // A leading "+" or surrounding spaces are not amounts.
+  const m = /^(\d{1,9})(?:\.(\d{1,2}))?$/.exec(amount);
   if (!m) return null;
   return Number(m[1]) * 100 + Number((m[2] ?? "").padEnd(2, "0"));
 }
diff --git a/test/expenses.money.test.ts b/test/expenses.money.test.ts
--- a/test/expenses.money.test.ts
+++ b/test/expenses.money.test.ts
@@ -40,3 +40,13 @@
   it("OB-3: rejects more than two decimal places", async () => {
     expect(toCents("1.005")).toBeNull();
   });
+
+  // OB-5: amounts with a sign or surrounding spaces are rejected.
+  it.each(["+1.00", "-1.00", " 1.00", "1.00 ", "1 .00"])("OB-5: rejects %j", (input) => {
+    expect(toCents(input)).toBeNull();
+  });
+
+  it("OB-5: still accepts the plain forms either side of the edge", () => {
+    expect(toCents("1")).toBe(100);
+    expect(toCents("1.5")).toBe(150);
+  });
 });
