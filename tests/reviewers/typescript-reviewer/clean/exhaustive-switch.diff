diff --git a/src/expenses/labels.ts b/src/expenses/labels.ts
new file mode 100644
--- /dev/null
+++ b/src/expenses/labels.ts
@@ -0,0 +1,14 @@
+import type { Status } from "../approvals/service.js";
+
+export function statusLabel(status: Status): string {
+  switch (status) {
+    case "submitted": return "Waiting for approval";
+    case "approved": return "Approved";
+    case "rejected": return "Rejected";
+    case "paid": return "Paid";
+    default: {
+      const unreachable: never = status;
+      throw new Error(`unknown status: ${unreachable}`);
+    }
+  }
+}
