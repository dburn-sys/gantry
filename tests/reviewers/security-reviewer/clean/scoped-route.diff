diff --git a/src/routes/receipts.ts b/src/routes/receipts.ts
new file mode 100644
--- /dev/null
+++ b/src/routes/receipts.ts
@@ -0,0 +1,19 @@
+import type { FastifyInstance } from "fastify";
+import { withCompany } from "../db.js";
+
+const UUID = /^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$/i;
+
+export function registerReceiptRoutes(app: FastifyInstance) {
+  // Runs behind requireUser. Row-level security limits rows to the caller's
+  // company, and the WHERE limits everyone but approvers and finance to their own receipts.
+  app.get("/receipts/:id/image", async (req, reply) => {
+    const { id } = req.params as { id: string };
+    if (!UUID.test(id)) return reply.code(400).send();
+    const user = req.user!;
+    const { rows } = await withCompany(user.companyId, (db) => db.query(
+      `SELECT image FROM receipts WHERE id = $1 AND ($2 IN ('approver', 'finance') OR user_id = $3)`,
+      [id, user.role, user.id]));
+    if (!rows[0]) return reply.code(404).send();
+    return reply.type("image/jpeg").send(rows[0].image);
+  });
+}
